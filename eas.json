{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true
    },
    "dev-sideload": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "chatgpt-phone-test": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "CALMERA_PHONE_TEST": "1",
        "ENTRY_FILE": "./phone-test-entry.jsx"
      }
    },
    "chatgpt-testflight": {
      "distribution": "store",
      "developmentClient": false,
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "CALMERA_PHONE_TEST": "1",
        "ENTRY_FILE": "./phone-test-entry.jsx"
      }
    },
    "chatgpt-test-simulator": {
      "distribution": "internal",
      "developmentClient": false,
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "env": {
        "CALMERA_PHONE_TEST": "1",
        "ENTRY_FILE": "./phone-test-entry.jsx"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
