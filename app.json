{
  "expo": {
    "name": "foodwrap.",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "8",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow foodwrap to use the microphone for voice logging.",
        "NSSpeechRecognitionUsageDescription": "This app uses speech recognition to process your voice logs, but your audio data is not stored on our servers.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow foodwrap to use the camera to capture meal photos and read scale displays.",
        "NSPhotoLibraryUsageDescription": "Allow foodwrap to access your photo library to load/import meal photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow foodwrap to save captured photos to your photo library."
      },
      "bundleIdentifier": "com.yfwu02.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yfwu02.mobile",
          "publishableKey": "pk_test_51SCMuS36oMPBfRNmbj1vsVV1Daq6qey8UwWWczBBAdl0d0L2jmpererin1jFQ9BkF8g4GbLh9jHaClUqBcrDfrdN003ntlrp91"
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "clerkPublishableKey": "pk_test_Zm9uZC1nYXRvci00Ni5jbGVyay5hY2NvdW50cy5kZXYk",
      "router": {},
      "stripe": {
        "publishableKey": "pk_test_51SCMuS36oMPBfRNmbj1vsVV1Daq6qey8UwWWczBBAdl0d0L2jmpererin1jFQ9BkF8g4GbLh9jHaClUqBcrDfrdN003ntlrp91",
        "merchantIdentifier": "merchant.com.yfwu02.mobile"
      },
      "eas": {
        "projectId": "9ecd7d3c-4f54-4112-976a-f73234564951"
      }
    }
  }
}
