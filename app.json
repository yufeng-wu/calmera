{
  "expo": {
    "name": "Calmera",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "9",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "calmera uses the microphone when you log a meal by voice.",
        "NSSpeechRecognitionUsageDescription": "calmera turns what you say into text on this iPhone to log your meal. Your recording isn’t saved or sent anywhere.",
        "ITSAppUsesNonExemptEncryption": false,
        "RCTAsyncStorageExcludeFromBackup": true,
        "NSCameraUsageDescription": "calmera uses the camera when you take a photo of a meal.",
        "NSPhotoLibraryUsageDescription": "Choose a meal photo for a nutrition estimate."
      },
      "bundleIdentifier": "com.yfwu02.calmera",
      "appleTeamId": "2G2578H6DX"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF9"
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ecd7d3c-4f54-4112-976a-f73234564951"
      }
    }
  }
}
