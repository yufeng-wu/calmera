{
  "expo": {
    "name": "calmera.",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "8",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "calmera uses the microphone when you log a meal by voice.",
        "NSSpeechRecognitionUsageDescription": "calmera turns what you say into text on this iPhone to log your meal. Your recording isn’t saved or sent anywhere.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "calmera uses the camera when you take a photo of a meal.",
        "NSPhotoLibraryUsageDescription": "Allow calmera to access your photo library to load/import meal photos.",
        "NSPhotoLibraryAddUsageDescription": "Allow calmera to save captured photos to your photo library."
      },
      "bundleIdentifier": "com.yfwu02.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF9"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yfwu02.mobile",
          "publishableKey": "pk_test_51SCMuS36oMPBfRNmbj1vsVV1Daq6qey8UwWWczBBAdl0d0L2jmpererin1jFQ9BkF8g4GbLh9jHaClUqBcrDfrdN003ntlrp91"
        }
      ],
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "stripe": {
        "publishableKey": "pk_test_51SCMuS36oMPBfRNmbj1vsVV1Daq6qey8UwWWczBBAdl0d0L2jmpererin1jFQ9BkF8g4GbLh9jHaClUqBcrDfrdN003ntlrp91",
        "merchantIdentifier": "merchant.com.yfwu02.mobile"
      },
      "eas": {
        "projectId": "9ecd7d3c-4f54-4112-976a-f73234564951"
      }
    }
  }
}
